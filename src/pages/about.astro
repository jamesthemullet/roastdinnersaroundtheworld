---
import BaseLayout from "../layouts/BaseLayout.astro";
import "./pages.css";
import { Image } from "astro:assets";
import { fetchSinglePost } from "../lib/api";
import { PAGE_IDS } from "../lib/pageIds";

const singlePost = await fetchSinglePost(PAGE_IDS.ABOUT);
---

<BaseLayout
  pageTitle={singlePost.title}
  description={singlePost.seo.opengraphDescription}
  opengraphImage={singlePost.seo.opengraphImage?.sourceUrl}
>
  <Image
    src={singlePost.featuredImage?.node.sourceUrl}
    alt={singlePost.title}
    width={singlePost.featuredImage?.node.mediaDetails?.width ?? 1200}
    height={singlePost.featuredImage?.node.mediaDetails?.height ?? 900}
    class="featured-image"
  />
  <div class="container">
    <h2>{singlePost.title}</h2>
    <div set:html={singlePost.content} />
  </div>
</BaseLayout>
