---
import BaseLayout from "../layouts/BaseLayout.astro";
import { fetchSinglePost } from "../lib/api";
import "./pages.css";
import { PAGE_IDS } from "../lib/pageIds";

const singlePost = await fetchSinglePost(PAGE_IDS.TO_DO_LIST);
---

<BaseLayout
  pageTitle={singlePost.title}
  description={singlePost.seo.opengraphDescription}
  opengraphImage={singlePost.seo.opengraphImage?.sourceUrl}
>
  <div class="container">
    <h2>{singlePost.title}</h2>
    <div set:html={singlePost.content} />
  </div>
</BaseLayout>
